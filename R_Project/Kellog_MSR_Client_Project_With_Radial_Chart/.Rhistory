filter(category == .category)
# Define colors for the line and area
.line_color <- "#BED2E0"
.area_color <- "#E4F4FF"
# Create the Plotly object with the filtered data
p <- plot_ly(filtered_data, x = ~period, y = ~value, type = "scatter", mode = "lines") %>%
add_trace(fill = "tozeroy", fillcolor = .area_color, line = list(color = .line_color, width = 1)) %>%
config(displayModeBar = FALSE) %>%
layout(
xaxis = list(title = "xyz", showline = FALSE, zeroline = FALSE, showticklabels = FALSE, range = c(min(filtered_data$period), max(filtered_data$period)), automargin = TRUE),
yaxis = list(title = "abc", showline = FALSE, zeroline = FALSE, showticklabels = FALSE, range = c(0, max(filtered_data$value)), automargin = TRUE),
showlegend = FALSE,
margin = list(l = 0, r = 0, b = 0, t = 0),
paper_bgcolor = "white",
plot_bgcolor = "white"
)
return(p)
}
