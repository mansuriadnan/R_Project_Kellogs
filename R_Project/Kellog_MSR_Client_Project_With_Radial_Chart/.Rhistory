library(plotly)
# Example data (replace with your actual data)
df <- data.frame(
x = seq(1, 10),
y = rnorm(10)
)
# Create a line plot
fig <- plot_ly(df, x = ~x, y = ~y, type = "scatter", mode = "lines")
# Adjust the x-axis range to remove left space
fig <- fig %>% layout(xaxis = list(range = c(1, 10)))
# Show the plot
fig
