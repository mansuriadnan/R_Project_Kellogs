library(shiny)
library(ggplot2)
library(ggtext)
ui <- fluidPage(
plotOutput("plot")
)
server <- function(input, output) {
output$plot <- renderPlot({
ggplot(mtcars, aes(x = factor(cyl), y = mpg, fill = factor(cyl))) +
geom_bar(stat = "identity") +
labs(x = "Number of Cylinders", y = "Miles per Gallon") +
theme_minimal() +
geom_text(aes(label = paste("MPG:", mpg)),
position = position_stack(vjust = 0.5),
size = 3,
family = "Arial",
color = "black") +
theme(plot.margin = margin(1, 1, 3, 1, "cm"))
})
}
shinyApp(ui, server)
library(shiny)
library(ggplot2)
ui <- fluidPage(
plotOutput("plot")
)
server <- function(input, output) {
output$plot <- renderPlot({
p <- ggplot(mtcars, aes(x = factor(cyl), y = mpg, fill = factor(cyl))) +
geom_bar(stat = "identity") +
labs(x = "Number of Cylinders", y = "Miles per Gallon") +
theme_minimal()
# Add geom_text to display values
p <- p + geom_text(aes(label = paste("MPG:", mpg)),
position = position_stack(vjust = 0.5),
family = "Arial",
color = "black",
show.legend = FALSE,
size = 0)  # Size set to 0 initially
p <- p + ggplot2::theme(plot.margin = margin(1, 1, 3, 1, "cm"))
p
})
# JS code to dynamically update the size of geom_text
observe({
jscode <- "function(el, x) {
el.on('plotly_hover', function(d) {
var xp = d.points[0].x;
var yp = d.points[0].y;
var curveNumber = d.points[0].curveNumber;
var size = d.points[0].data.text[0].split('<br>')[1].split(':')[1];
var plotlyDiv = document.getElementById(el.id);
var myPlot = plotlyDiv.data[curveNumber];
var gs = myPlot.xaxis._categories.length;
var id = 'g-' + curveNumber;
var g = d3.select('#' + id);
g.selectAll('text').attr('font-size', size + 'px');
})
}"
# Register custom JS code with plotly
onRender(
"plot",
jscode
)
})
}
shinyApp(ui, server)
library(shiny)
library(ggplot2)
ui <- fluidPage(
plotOutput("plot")
)
server <- function(input, output) {
output$plot <- renderPlot({
p <- ggplot(mtcars, aes(x = factor(cyl), y = mpg, fill = factor(cyl))) +
geom_bar(stat = "identity") +
labs(x = "Number of Cylinders", y = "Miles per Gallon") +
theme_minimal()
# Add invisible geom_text for tooltip
p <- p + geom_text(aes(label = paste("MPG:", mpg)),
position = position_stack(vjust = 0.5),
family = "Arial", color = "black",
alpha = 0, size = 5)
p
})
observe({
# JavaScript to handle tooltip behavior
js <- "
$(document).ready(function() {
$('rect').mouseover(function() {
var index = $(this).index();
var mpg = $(this).siblings('g').find('text').eq(index).text();
$(this).siblings('g').find('text').eq(index).attr('fill-opacity', 1);
$(this).siblings('g').find('text').eq(index).attr('font-size', '14px');
$(this).siblings('g').find('text').eq(index).attr('font-weight', 'bold');
$(this).siblings('g').find('text').eq(index).attr('text-anchor', 'middle');
$(this).siblings('g').find('text').eq(index).attr('x', parseInt($(this).attr('x')) + parseInt($(this).attr('width')) / 2);
$(this).siblings('g').find('text').eq(index).attr('y', parseInt($(this).attr('y')) + parseInt($(this).attr('height')) / 2);
$(this).siblings('g').find('text').eq(index).text(mpg);
});
$('rect').mouseout(function() {
$(this).siblings('g').find('text').attr('fill-opacity', 0);
$(this).siblings('g').find('text').text('');
});
});
"
# Execute JavaScript
session$sendCustomMessage("addTooltip", js)
})
}
shinyApp(ui, server)
