server <- function(input, output) {
output$table <- renderReactable({
reactable(
iris,
details = function(index) {
tagList(
"Details for Row ", index,
tags$ul(
tags$li(paste("Species:", iris$Species[index])),
tags$li(paste("Sepal Length:", iris$Sepal.Length[index])),
tags$li(paste("Sepal Width:", iris$Sepal.Width[index])),
tags$li(paste("Petal Length:", iris$Petal.Length[index])),
tags$li(paste("Petal Width:", iris$Petal.Width[index]))
)
)
}
)
})
}
shinyApp(ui, server)
