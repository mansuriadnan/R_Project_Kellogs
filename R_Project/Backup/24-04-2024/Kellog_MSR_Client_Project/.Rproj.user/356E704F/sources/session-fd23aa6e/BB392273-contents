:root {
  --msr-up-color: #65B741;
  --msr-down-color: #FAA300;
  --msr-value-color: #38419D;
  --msr-border-color: #B3C2D75F; 
  --msr-title-color: #132043; 
}

/* msr-specific colors */
.green-box { 
  background: var(--msr-up-color); 
  color: white;
}

.orange-box {
  background: var(--msr-down-color); 
  color: white;
}

.green-color-text { 
  color: var(--msr-up-color); 
}

.orange-color-text {
  color: var(--msr-down-color); 
}





.net-sales-value-inner {
  width: 50%; 
}

.net-sales-value-inner:first-child {
  border-radius: 10px 0px 0px 10px; 
}

.net-sales-value-inner:last-child { 
  border-radius: 0px 10px 10px 0px; 
  border-left: 0px; 
}

.net-sales-value-box { 
  padding: 30px 5px; 
  border-radius: 10px; 
  border: 1px solid var(--msr-border-color); 
  background: #fff; 
  box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 12px;
}


.common-inner-value-box { 
  padding: 0.6em; 
  border: 1px solid var(--msr-border-color); 
  border-radius: 0.6em; 
  display: flex; 
  justify-content: space-between; 
}

.common-inner-value-box:not(:last-child) { 
  margin-bottom: 0.9em; 
}



.value-vs { 
  display: flex; 
  align-items: center; 
  font-weight: 300; 
  line-height: 1; 
  text-align: left; 
  color: gray; 
}




.value-vs-result { 
  display: flex; 
  align-items: center; 
} 

.value-vs-result span { 
  padding: 2px 3px; 
  border-radius: 3px; 
  display: block; 
  font-weight: 700; 
  line-height: 1; 
  text-align: left; 
  margin-left: 0.2em; 
}


/*  OP Profitability Section */

.index-value { 
  display: flex;
  align-items: center;
  padding: 10px 10px 0px 10px;
}

.index-vs-ya {
    margin-bottom: 5%;
    font-size: 1.6vw;
}

.card-title{ 
  font-size: 1vw;
  color: var(--msr-title-color); 
  margin: 0px 
}

.index-value i{ 
  font-size:70%;
  color:var(--msr-up-color);
  margin-left:0.2em 
}

.index-vs-ya  p{ 
  font-size:50%;
  padding: 0px 10px 0px 10px;
  margin-bottom: 5px;
}

.sales-value-with-graph .index-vs-ya{ 
  border :1px solid var(--msr-border-color); 
  border-radius: 10px;
  overflow: hidden;
}


.net-value-sale span{ 
  display: block; 
  font-weight: 700;
  font-size: 82%; 
  line-height: 1; 
  text-transform: capitalize;
}

.shiny-html-output span strong {
    font-weight: 700 !IMPORTANT;
    color: #000;
}
