library(tibble)
library(dplyr)
library(purrr)
# Create sample data
dummy_op_profibility_data <- tibble(
ref = c("ya", "iop", "le", "ya", "iop", "le"),
value = c(30, 45, 50, 110, 120, 130) * 1e4,
ref_value = c(50, 50, 50, 140, 140, 140) * 1e4,
category = c("mtd", "mtd", "mtd", "ytd", "ytd", "ytd"),
period = as.Date("2024-4-1")
)
# Extract the starting date
start_date <- min(dummy_op_profibility_data$period)
# Create a tibble with a sequence of dates covering 12 months
dates <- tibble(period = seq(start_date, by = "1 month", length.out = 12))
# Replicate the sample data for each month
op_profibility_graph_data <- dates %>%
mutate(period = map(period, ~ tibble(dummy_op_profibility_data, period = .x))) %>%
unnest(period)
library(tibble)
library(dplyr)
library(purrr)
# Create sample data
dummy_op_profibility_data <- tibble(
ref = c("ya", "iop", "le", "ya", "iop", "le"),
value = c(30, 45, 50, 110, 120, 130) * 1e4,
ref_value = c(50, 50, 50, 140, 140, 140) * 1e4,
category = c("mtd", "mtd", "mtd", "ytd", "ytd", "ytd"),
period = as.Date("2024-4-1")
)
# Extract the starting date
start_date <- min(dummy_op_profibility_data$period)
# Create a tibble with a sequence of dates covering 12 months
dates <- tibble(period = seq(start_date, by = "1 month", length.out = 12))
# Replicate the sample data for each month
op_profibility_graph_data <- dates %>%
mutate(period_month = map(period, ~ tibble(dummy_op_profibility_data, month_period = .x))) %>%
unnest(cols = c(period_month))
