df <- data.frame(type = c("on", "ia"),
                 radius = c(1,3),
                 value = c(20,30))

library(ggplot2); library(ggforce)
ggplot(df) +
  geom_link(aes(x = radius, xend = radius,
                y = 0, yend = value), 
            size = 17, lineend = "round", color = "white") +
  geom_link(aes(x = radius, xend = radius,
                y = 0, yend = value, color = type), 
            size = 16, lineend = "round") +
  scale_x_continuous(limits = c(0,4)) +
  scale_y_continuous(limits = c(0, 30)) +
  scale_color_manual(values = c("on" = "#FAA300", 
                                "ia" = "#7492E3"
                                )) +
  guides(color = "none") +
  coord_polar(theta = "y") + 
  theme_void()