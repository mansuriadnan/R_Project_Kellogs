df <- data.frame(type = c("on", "n"),
                 radius = c(2,3),
                 value = c(50,100))

library(ggplot2); library(ggforce)
ggplot(df) +
  geom_link(aes(x = radius, xend = radius,
                y = 0, yend = value), 
            size = 17, lineend = "round", color = "#7492E3") +
  geom_link(aes(x = radius, xend = radius,
                y = 0, yend = value, color = type), 
            size = 16, lineend = "round") +
  # geom_label(aes(radius, y = 30, 
  #                label = paste(type, ": ", value)), hjust = 1.8) +
  scale_x_continuous(limits = c(0,4)) +
  scale_y_continuous(limits = c(0, 100)) +
  scale_color_manual(values = c("on" = "#FAA300", 
                                "n" = "#7492E3")) +
  guides(color = "none") +
  coord_polar(theta = "y") + 
  theme_void()